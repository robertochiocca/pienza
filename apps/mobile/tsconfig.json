{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // DOM entra por causa de web/, que e o harness e roda no navegador. As telas em
    // src/ e o App.tsx nao tocam em nada de DOM; a separacao hoje e a pasta.
    "lib": ["ES2022", "DOM"],
    "types": ["react", "react-dom"],
    "resolveJsonModule": true
  },
  // Sem alias de `react-native`: os tipos vem do proprio react-native, que agora e
  // dependencia de verdade e nao mais so fonte de tipos. Quem troca a implementacao por
  // react-native-web e o esbuild, e so no harness.
  "include": ["src", "web", "scripts", "App.tsx"]
}
