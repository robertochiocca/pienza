{
  "name": "@pienza/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "App do Pienza. As telas sao React Native; o harness web existe para ve-las rodando antes do Expo.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "capturar": "node scripts/capturar.mjs",
    "gate:quadro": "node scripts/capturar.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "^57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.25.12",
    "playwright": "^1.57.0"
  },
  "main": "expo/AppEntry.js"
}
