# Copie para .env (que esta no .gitignore) e preencha.
# Nenhuma chave secreta entra neste arquivo nem no cliente.

# Projeto Supabase local (supabase start imprime estes valores)
SUPABASE_URL=http://127.0.0.1:54321

# Chave publicavel: pode ir para o bundle do app, protegida por RLS.
SUPABASE_PUBLISHABLE_KEY=

# NUNCA colocar a service role key aqui nem em qualquer arquivo lido pelo app.
# Ela vive apenas nos secrets do ambiente de Edge Functions e do CI.
