{
  "name": "pienza",
  "version": "0.0.0",
  "private": true,
  "description": "Acompanhamento de composicao e proporcao corporal",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "audit:deps": "npm audit --audit-level=low",
    "gate:mecanicas": "node scripts/gate-mecanicas-proibidas.mjs",
    "gate:dominio-puro": "node scripts/gate-dominio-puro.mjs",
    "db:test": "bash scripts/db-test.sh",
    "check": "npm run format && npm run lint && npm run typecheck && npm test && npm run gate:mecanicas && npm run gate:nome && npm run gate:cores && npm run gate:segredos && npm run gate:papel && npm run gate:dominio-puro && npm run audit:deps",
    "gate:nome": "node scripts/gate-nome-antigo.mjs",
    "gate:cores": "node scripts/gate-cores.mjs",
    "gate:segredos": "node scripts/gate-segredos.mjs",
    "gate:segredos:historico": "node scripts/gate-segredos.mjs --historico",
    "gate:papel": "node scripts/gate-suite-papel.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  }
}
